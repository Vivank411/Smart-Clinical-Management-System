DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Use a Gmail App Password (not your regular password).
# Steps: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=you@example.com
SMTP_REPLY_TO=you@example.com
CLINIC_NAME=MediClinic

# ── Locale ───────────────────────────────────────────────────────────────────
# Every timestamp the system records (audit log, check-ins, consultations) is
# stamped in this timezone, regardless of what the host machine is set to.
# Any IANA zone name works, e.g. Asia/Kolkata, Asia/Dubai, Europe/London.
CLINIC_TIMEZONE=Asia/Kolkata
# Dialling code prefixed to 10-digit mobile numbers for WhatsApp links.
CLINIC_COUNTRY_CODE=91

# ── Payments (counter collection) ────────────────────────────────────────────
# One flat fee for every patient, collected at the desk by QR, card or cash.
# The payment QR itself is uploaded in the app: Settings -> Payment Settings.

# The single consultation fee charged to every patient.
CONSULTATION_FEE=500
PAYMENT_CURRENCY=INR

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Optional — enables the AI layer of the prescription drug checker.
ANTHROPIC_API_KEY=your-anthropic-api-key
